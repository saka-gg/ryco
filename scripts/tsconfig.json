{
  "extends": "../tsconfig.node.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "includeSuggestionsInTsc": false,
        "diagnosticSeverity": {
          "unstableApiUsage": "off",
          "experimentalApiUsage": "off"
        }
      }
    ]
  },
  "include": ["**/*.ts"]
}
