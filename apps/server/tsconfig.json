{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node", "bun"],
    "lib": ["ESNext", "esnext.disposable"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "includeSuggestionsInTsc": false,
        "namespaceImportPackages": ["@effect/platform-node"],
        "diagnosticSeverity": {
          "unstableApiUsage": "off",
          "experimentalApiUsage": "off",
          "anyUnknownInErrorContext": "warning",
          "instanceOfSchema": "warning",
          "deterministicKeys": "off",
          "preferSchemaOverJson": "off",
          "globalErrorInEffectFailure": "off"
        }
      }
    ]
  },
  "include": [
    "src",
    "tsdown.config.ts",
    "vitest.config.ts",
    "test",
    "scripts",
    "integration",
    "../../scripts/lib",
    "../../vitest.*.ts"
  ]
}
