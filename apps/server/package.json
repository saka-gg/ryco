{
  "name": "ryco-cli",
  "version": "0.1.24",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saka-gg/ryco.git",
    "directory": "apps/server"
  },
  "bin": {
    "ryco": "dist/bin.mjs",
    "ryco-cli": "dist/bin.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch src/bin.ts",
    "build": "node scripts/cli.ts build",
    "build:bundle": "tsdown",
    "start": "node dist/bin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:process-reaper": "vp test run src/server.test.ts src/provider/Layers/ClaudeAdapter.test.ts src/provider/Layers/ProviderSessionDirectory.test.ts src/provider/Layers/ProviderSessionReaper.test.ts src/provider/Layers/CodexAdapter.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "@anthropic-ai/sdk": "^0.124.0",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@github/copilot-sdk": "1.0.13",
    "@github/keytar": "7.10.6",
    "@opencode-ai/sdk": "^1.18.29",
    "@pierre/diffs": "catalog:",
    "effect": "catalog:",
    "node-pty": "^1.1.0",
    "open": "^11.0.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@ryco/client-runtime": "workspace:*",
    "@ryco/contracts": "workspace:*",
    "@ryco/shared": "workspace:*",
    "@ryco/tailscale": "workspace:*",
    "@ryco/web": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
