+#[tokio::test]
+async fn dom_type_keeps_attempted_input_unknown_when_readback_fails() {
+    let f = fixture_with(|state| state.dom_type_readback_matched = false).await;
+    let (target, tab) = bind(&f).await;
+    let snap = snapshot(&f, &target, &tab).await;
+    let input_ref = ref_of(&snap, "main", "Shadow Input");
+
+    let mismatch = BrowserTypeTool::new(f.engine.clone())
+        .invoke(json!({
+            "target_id": target, "tab_id": tab, "ref": input_ref,
+            "text": "hello", "input_route": "dom_event", "session": SESSION
+        }))
+        .await;
+    assert_eq!(structured(&mismatch)["effect"], "unverifiable");
+    assert!(structured(&mismatch).get("delivered_chars").is_none());
+    let public = ActionExecutionRecord::from_legacy(
+        "browser_type",
+        &json!({ "input_route": "dom_event" }),
+        structured(&mismatch),
+    )
+    .unwrap()
+    .public_result()
+    .unwrap();
+    assert_eq!(
+        public.effect,
+        cua_driver_contract::ActionEffect::Unverifiable
+    );
+    assert!(recorded_calls(&f, "Input.insertText").is_empty());
+
+    let unconfirmed = fixture_with(|state| state.dom_type_dispatched = false).await;
+    let (target, tab) = bind(&unconfirmed).await;
+    let snap = snapshot(&unconfirmed, &target, &tab).await;
+    let input_ref = ref_of(&snap, "main", "Shadow Input");
+    let attempted = BrowserTypeTool::new(unconfirmed.engine.clone())
+        .invoke(json!({
+            "target_id": target, "tab_id": tab, "ref": input_ref,
+            "text": "hello", "input_route": "dom_event", "session": SESSION
+        }))
+        .await;
+    assert_eq!(structured(&attempted)["effect"], "unverifiable");
+    assert!(structured(&attempted).get("delivered_chars").is_none());
+
+    // An element kind with no synthetic insertion returns the honest
+    // browser_action_unavailable refusal instead of a false success.
+    let unsupported = fixture_with(|state| state.dom_type_kind = "unsupported".into()).await;
+    let (target, tab) = bind(&unsupported).await;
+    let snap = snapshot(&unsupported, &target, &tab).await;
+    let input_ref = ref_of(&snap, "main", "Shadow Input");
+    let refused = BrowserTypeTool::new(unsupported.engine.clone())
+        .invoke(json!({
+            "target_id": target, "tab_id": tab, "ref": input_ref,
+            "text": "hello", "input_route": "dom_event", "session": SESSION
+        }))
+        .await;
+    assert_eq!(
+        structured(&refused)["refusal"]["code"],
+        "browser_action_unavailable"
+    );
+    assert!(recorded_calls(&unsupported, "Input.insertText").is_empty());
+}
