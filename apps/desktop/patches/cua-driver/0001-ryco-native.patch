+    // replayed through a CGEvent queue.
+    pulse_ax_return_with(
+        super::cancellation::gate(),
+        element,
+        |down| unsafe {
+            AXUIElementPostKeyboardEvent(
+                application.as_ptr() as crate::ax::bindings::AXUIElementRef,
+                13,
+                36,
+                u8::from(down),
+            )
+        },
