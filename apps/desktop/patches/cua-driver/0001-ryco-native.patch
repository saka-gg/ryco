+
+impl KeyboardRoute {
+    fn post(self, event: &CGEvent) {
+        match self {
+            Self::Hid => event.post(core_graphics::event::CGEventTapLocation::HID),
+            Self::Pid {
+                pid,
+                authenticated: true,
+            } => post_keyboard_event(pid, event),
+            Self::Pid {
+                pid,
+                authenticated: false,
+            } => post_keyboard_event_no_auth(pid, event),
