+
+    /// Admit one application-menu AX action. Menu items hang off the app's
+    /// menu bar, not a window, so there is no modal ancestry to prove; the
+    /// exact target (window, Space, geometry) is still revalidated.
+    pub fn post_menu<T>(&self, send: impl FnOnce() -> T) -> anyhow::Result<T> {
+        let mut state = self.lock();
