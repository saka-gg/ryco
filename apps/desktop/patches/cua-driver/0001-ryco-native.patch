+        }
+        let parent_ax_id = run.parent_backend_node_id.and_then(|parent| {
+            nodes
+                .iter()
+                .find(|node| node.backend_node_id == Some(parent))
+                .map(|node| node.ax_id.clone())
+        });
+        nodes.push(SemanticNode {
+            ax_id: format!("domtext-{}", run.backend_node_id),
+            parent_ax_id,
+            child_ax_ids: Vec::new(),
+            backend_node_id: Some(run.backend_node_id),
+            role: "text".to_owned(),
+            name: Some(text),
+            value: None,
+            states: BTreeMap::new(),
