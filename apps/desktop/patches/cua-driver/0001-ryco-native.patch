+#[tokio::test]
+async fn dom_type_delivers_synthetically_without_standalone_trusted_input() {
+    let f = fixture_with_platform(|_| {}, true).await;
+    let (target, tab) = bind(&f).await;
+    let snap = snapshot(&f, &target, &tab).await;
+    let input_ref = ref_of(&snap, "main", "Shadow Input");
+
+    // The explicit synthetic route delivers in full background: no
+    // Input-domain event, a live read-back, and an honest unverifiable
+    // verdict.
+    let synthetic_args = json!({
+        "target_id": target, "tab_id": tab, "ref": input_ref,
+        "text": "hello", "input_route": "dom_event", "session": SESSION
+    });
+    let synthetic = BrowserTypeTool::new(f.engine.clone())
+        .invoke(synthetic_args.clone())
+        .await;
+    let parsed = structured(&synthetic);
+    assert_eq!(parsed["status"], "ok", "{parsed}");
+    assert_eq!(parsed["route"], "dom_event");
+    assert_eq!(parsed["effect"], "unverifiable");
+    assert_eq!(parsed["dispatched"], true);
+    assert_eq!(parsed["readback"], "matched");
+    assert_eq!(parsed["delivered_chars"], 5);
+    assert_eq!(parsed["escalation"]["recommended"], "page");
+    assert!(synthetic.content.iter().any(|content| matches!(
+        content,
+        crate::protocol::Content::Text { text, .. }
+            if text.contains("application effect not verified")
+    )));
+    let functions: Vec<String> = recorded_calls(&f, "Runtime.callFunctionOn")
+        .iter()
+        .filter_map(|(_, params)| params["functionDeclaration"].as_str().map(str::to_owned))
+        .collect();
+    assert!(
+        functions
+            .iter()
+            .any(|function| function.contains("cua-dom-insert")),
+        "the synthetic insertion must run through the DOM route: {functions:?}"
+    );
+    assert!(
+        functions
+            .iter()
+            .any(|function| function.contains("cua-dom-readback")),
+        "the synthetic insertion must be read back: {functions:?}"
+    );
+    assert!(recorded_calls(&f, "Input.insertText").is_empty());
+    assert!(recorded_calls(&f, "Input.dispatchKeyEvent").is_empty());
+    assert!(recorded_calls(&f, "Emulation.setFocusEmulationEnabled").is_empty());
+    assert!(recorded_calls(&f, "DOM.focus").is_empty());
+    assert!(recorded_calls(&f, "Page.bringToFront").is_empty());
+    assert!(recorded_calls(&f, "Target.activateTarget").is_empty());
+
+    // The closed action contract projects the DOM route, background
+    // delivery, and the unverifiable effect without leaking page content.
+    let public =
+        ActionExecutionRecord::from_legacy("browser_type", &synthetic_args, structured(&synthetic))
+            .expect("browser type action record")
+            .public_result()
+            .expect("public browser type result");
+    let public = serde_json::to_value(public).expect("serialize public result");
+    assert_eq!(public["effect"], "unverifiable", "{public}");
+    assert_eq!(public["route"], "dom", "{public}");
+    assert_eq!(public["delivery"]["mode"], "background", "{public}");
+    assert_eq!(public["escalation"]["target"], "page", "{public}");
+    assert!(
+        !public.to_string().contains("hello"),
+        "text leaked: {public}"
+    );
+}
