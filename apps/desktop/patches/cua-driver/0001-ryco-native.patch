+    async fn dialog_on(opener: &'static str) -> (MockCdpServer, Arc<Mutex<Vec<Value>>>) {
+        let events = Arc::new(Mutex::new(Vec::new()));
+        let server_events = events.clone();
+        let blocked = Arc::new(AtomicBool::new(false));
+        let server = MockCdpServer::start(Arc::new(move |call| {
+            server_events.lock().unwrap().push(call.params.clone());
+            if blocked.load(Ordering::SeqCst) {
+                return MockReply::hang();
+            }
+            if call.params["type"] == opener {
+                blocked.store(true, Ordering::SeqCst);
+                return MockReply::hang().with_events(vec![MockEvent {
+                    method: "Page.javascriptDialogOpening".into(),
+                    session_id: Some("tab".into()),
+                    params: json!({ "type": "alert" }),
+                }]);
+            }
+            MockReply::ok(json!({}))
+        }))
+        .await;
+        (server, events)
+    }
+
