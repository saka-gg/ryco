+/// Synthetic, fully background text insertion for one editable ref.
+///
+/// The page-side function focuses the element, applies the text through the
+/// element's own native value setter (input/textarea) or
+/// `document.execCommand('insertText')` (contenteditable), dispatches
+/// `input`/`change`, and returns only the element kind, a dispatch proof and
+/// the expected post-state. Element text itself is never returned to the
+/// driver, so it can never reach a log or a tool result. The marker comment
+/// lets test fixtures recognize the call.
+const DOM_INSERT_TEXT: &str = r#"function(text, replace) {
+    /*cua-dom-insert*/
+    const tag = this.tagName;
+    const kind = tag === 'INPUT' ? 'input' : tag === 'TEXTAREA' ? 'textarea' : (this.isContentEditable ? 'contenteditable' : 'unsupported');
+    if (kind === 'unsupported') return { kind: kind, dispatched: false, expected: '', before: 0 };
+    if (typeof this.focus === 'function') this.focus();
+    if (kind === 'contenteditable') {
+        const before = Array.from(this.textContent || '').length;
+        if (replace) {
+            const doc = this.ownerDocument;
+            const range = doc.createRange();
+            range.selectNodeContents(this);
+            const selection = doc.getSelection();
+            if (!selection) return { kind: kind, dispatched: false, expected: '', before: before };
+            selection.removeAllRanges();
+            selection.addRange(range);
+        }
+        const ok = this.ownerDocument.execCommand('insertText', false, text);
+        this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+        this.dispatchEvent(new Event('change', { bubbles: true }));
+        return { kind: kind, dispatched: !!ok, expected: replace ? text : '', before: before };
+    }
+    const proto = kind === 'textarea' ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype;
+    const descriptor = Object.getOwnPropertyDescriptor(proto, 'value');
+    if (!descriptor || typeof descriptor.set !== 'function') return { kind: kind, dispatched: false, expected: '', before: 0 };
+    const value = this.value || '';
+    const before = Array.from(value).length;
+    let next;
+    if (replace) {
+        next = text;
+    } else {
+        const start = typeof this.selectionStart === 'number' ? this.selectionStart : value.length;
+        const end = typeof this.selectionEnd === 'number' ? this.selectionEnd : start;
+        next = value.slice(0, start) + text + value.slice(end);
+    }
+    descriptor.set.call(this, next);
+    this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+    return { kind: kind, dispatched: this.value === next, expected: next, before: before };
