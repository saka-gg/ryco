+/// Recheck document ancestry immediately before semantic mutation: a cached
+/// field can stay valid after its document is moved out of the window.
+/// Only positive clipping evidence refuses; unknown native geometry retains
+/// its existing semantics. All retained parents are released, including on
+/// timeout, and reads have both a per-object and overall bound.
+pub(crate) unsafe fn element_has_clipped_web_document(element: AXUIElementRef) -> bool {
+    // The first element is borrowed from the actuator. Its short inspection
+    // timeout must never leak into the subsequent AX mutation (which can land
+    // even when a too-short acknowledgement budget expires).
+    struct RestoreMutationTimeout(AXUIElementRef);
+    impl Drop for RestoreMutationTimeout {
+        fn drop(&mut self) {
+            unsafe {
+                super::bindings::AXUIElementSetMessagingTimeout(
+                    self.0,
+                    super::tree::AX_MESSAGING_TIMEOUT_SECONDS,
+                );
+            }
+        }
+    }
+    let _restore = RestoreMutationTimeout(element);
+    let deadline = std::time::Instant::now() + std::time::Duration::from_millis(150);
+    let mut current = element;
+    let mut owned = false;
+    let mut clipped = false;
+    for _ in 0..MAX_ANCESTRY_DEPTH {
+        if std::time::Instant::now() >= deadline {
+            break;
+        }
+        super::bindings::AXUIElementSetMessagingTimeout(current, 0.025);
+        let Some(role) = copy_string_attr(current, "AXRole") else {
+            break;
+        };
+        if matches!(role.as_str(), "AXWindow" | "AXApplication") {
+            break;
+        }
+        if super::tree::is_web_content_role(&role)
+            && web_document_is_clipped(
+                current,
+                &role,
+                super::bindings::element_screen_rect(current),
+            )
+        {
+            clipped = true;
+            break;
+        }
+        let parent = copy_element_attr(current, "AXParent");
+        if owned {
+            CFRelease(current as CFTypeRef);
+            owned = false;
+        }
+        let Some(parent) = parent else {
+            break;
+        };
+        current = parent;
+        owned = true;
+    }
+    if owned {
+        CFRelease(current as CFTypeRef);
+    }
+    clipped
+}
