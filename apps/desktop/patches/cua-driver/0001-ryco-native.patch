+/// A key-down and its key-up, both built before the down is posted.
+struct PreparedKey {
+    down: CGEvent,
+    up: CGEvent,
+    route: KeyboardRoute,
+    /// `(window_id, addressed element)` whose keyboard focus must still be
+    /// proven immediately before the down (catches a user switching windows
+    /// mid-chord). The release is never conditional.
+    required_focus_window: Option<(u32, Option<usize>)>,
+}
+
+impl PreparedKey {
+    fn new(
+        source: &CGEventSource,
+        code: u16,
+        down_flags: CGEventFlags,
+        up_flags: CGEventFlags,
+        route: KeyboardRoute,
+    ) -> anyhow::Result<Self> {
+        let down = CGEvent::new_keyboard_event(source.clone(), code, true)
+            .map_err(|_| anyhow::anyhow!("CGEvent keyboard down creation failed"))?;
+        let up = CGEvent::new_keyboard_event(source.clone(), code, false)
+            .map_err(|_| anyhow::anyhow!("CGEvent keyboard up creation failed"))?;
+        // HIDSystemState can inherit physically held modifiers. Always
+        // overwrite the flags, including the empty case.
+        down.set_flags(down_flags);
+        up.set_flags(up_flags);
+        Ok(Self::from_events(down, up, route))
+    }
+
+    fn from_events(down: CGEvent, up: CGEvent, route: KeyboardRoute) -> Self {
+        Self {
+            down,
+            up,
+            route,
+            required_focus_window: None,
+        }
+    }
+
+    /// Default-source (bare) transitions for physical chords on the HID queue.
+    fn bare(code: u16, down_flags: CGEventFlags, up_flags: CGEventFlags) -> anyhow::Result<Self> {
+        let down = create_bare_keyboard_event(code, true)?;
+        let up = create_bare_keyboard_event(code, false)?;
+        down.set_flags(down_flags);
+        up.set_flags(up_flags);
+        Ok(Self::from_events(down, up, KeyboardRoute::Hid))
+    }
