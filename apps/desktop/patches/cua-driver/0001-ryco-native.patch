+    // A driver-owned headless browser has no native window, so a trusted CDP
+    // Input dispatch cannot raise one.
+    if record.windowless {
+        return None;
+    }
+    let limitation = platform_limitation?;
+    let standalone = record.cdp_window_id.is_some()
+        || record.endpoint_access_class != super::types::EndpointAccessClass::EmbeddedApplication;
+    standalone.then_some(limitation)
