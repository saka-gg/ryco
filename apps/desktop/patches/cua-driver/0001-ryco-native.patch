+        if let Some(target) = &state.target {
+            target.verify_modal(element)?;
+            return Ok(());
+        }
+        if !state
+            .concurrent_targets
+            .values()
+            .any(|target| target.has_modal())
+        {
+            return Ok(());
+        }
+        if let Some(element) = element {
+            let window_id = unsafe {
