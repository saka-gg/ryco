+/// Held keys of one chord. `Vec` drops front to back; a chord must unwind in
+/// reverse order, so release pops from the back.
+struct HeldKeys<T>(Vec<T>);
+
+impl<T> HeldKeys<T> {
+    fn release(&mut self) -> anyhow::Result<()> {
+        let mut paused = Ok(());
+        while let Some(key) = self.0.pop() {
+            drop(key);
+            if paused.is_ok() {
+                paused = key_gap_pause();
+            }
+        }
+        paused
+    }
+}
