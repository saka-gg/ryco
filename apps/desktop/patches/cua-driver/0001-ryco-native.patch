+pub(crate) unsafe fn web_document_is_clipped(
+    element: AXUIElementRef,
+    role: &str,
+    frame: Option<[f64; 4]>,
+) -> bool {
+    if !super::tree::is_web_content_role(role) {
+        return false;
+    }
+    let Some(window) = copy_element_attr(element, "AXWindow") else {
+        return false;
+    };
+    super::bindings::AXUIElementSetMessagingTimeout(window, 0.025);
+    let window_frame = super::bindings::element_screen_rect(window);
+    CFRelease(window as CFTypeRef);
+    document_root_is_clipped(role, frame, window_frame)
