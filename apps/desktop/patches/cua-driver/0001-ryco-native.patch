+
+/// Post `down` with its release already built. Dropping the guard posts `up`
+/// exactly once: on success, error, cancellation and unwind.
+fn hold_mouse_button<'e>(
+    route: PostRoute,
+    pid: i32,
+    down: &CGEvent,
+    up: &'e CGEvent,
+) -> anyhow::Result<super::cancellation::HeldInput<'static, impl FnOnce() + 'e>> {
+    super::cancellation::gate().press(
+        || dispatch_mouse_event(route, pid, down),
+        move || dispatch_mouse_event(route, pid, up),
+    )
