+
+struct AxReturnRelease<'a> {
+    gate: &'a super::cancellation::InputGate,
+    error: std::cell::Cell<i32>,
+}
+
+impl Drop for AxReturnRelease<'_> {
+    fn drop(&mut self) {
+        if self.error.get() != 0 {
+            self.gate.mark_unconfirmed_release();
+        }
+    }
