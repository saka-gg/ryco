+/// One replaceable frame and at most one queued main-thread callback. A busy
+/// AppKit thread must not retain a tile for every render tick.
+struct FrameMailbox<T> {
+    pending: Option<T>,
+    scheduled: bool,
+}
+
+impl<T> FrameMailbox<T> {
+    fn new() -> Self {
+        Self {
+            pending: None,
+            scheduled: false,
+        }
+    }
+
+    /// Replace the pending frame; true when a callback must be scheduled.
+    fn submit(&mut self, frame: T) -> bool {
+        self.pending = Some(frame);
+        !std::mem::replace(&mut self.scheduled, true)
+    }
+
+    fn take(&mut self) -> Option<T> {
+        self.scheduled = false;
+        self.pending.take()
+    }
+}
