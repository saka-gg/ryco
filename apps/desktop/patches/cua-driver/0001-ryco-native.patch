+/// A document root parked outside its own window is not the active visual
+/// document, even when the application retains it in AXChildren. Chromium
+/// clamps fully clipped bounds to a one-point edge; ordinary controls below
+/// the fold are deliberately outside this document-root policy.
+pub(crate) fn document_root_is_clipped(
+    role: &str,
+    frame: Option<[f64; 4]>,
+    window_frame: Option<[f64; 4]>,
+) -> bool {
+    if !super::tree::is_web_content_role(role) {
+        return false;
+    }
+    let (Some(frame), Some(window)) = (frame, window_frame) else {
+        return false;
+    };
+    let valid = |rect: [f64; 4]| {
+        rect.iter().all(|value| value.is_finite())
+            && rect[2] >= 1.0
+            && rect[3] >= 1.0
+            && (rect[0] + rect[2]).is_finite()
+            && (rect[1] + rect[3]).is_finite()
+    };
+    if !valid(frame) || !valid(window) {
+        return false;
+    }
+    let width =
+        ((frame[0] + frame[2]).min(window[0] + window[2]) - frame[0].max(window[0])).max(0.0);
+    let height =
+        ((frame[1] + frame[3]).min(window[1] + window[3]) - frame[1].max(window[1])).max(0.0);
+    (frame[2] > 1.0 && width <= 1.0) || (frame[3] > 1.0 && height <= 1.0)
+}
