+// Rich data stays inside this native process. Tokens reveal no clipboard bytes.
+const MAX_SNAPSHOT_BYTES: usize = 16 * 1024 * 1024;
+const MAX_SNAPSHOT_ITEMS: usize = 32;
+const MAX_SNAPSHOT_TYPES: usize = 128;
+const SNAPSHOT_TTL: std::time::Duration = std::time::Duration::from_secs(120);
+type ClipboardItems = Vec<Vec<(String, zeroize::Zeroizing<Vec<u8>>)>>;
+
+struct PreservedClipboard {
+    token: String,
+    expected_change: isize,
+    expires: std::time::Instant,
+    items: ClipboardItems,
+}
+
+unsafe fn capture_items(board: &NSPasteboard) -> Result<(isize, ClipboardItems), String> {
+    let version = board.changeCount();
+    let mut contents = Vec::new();
+    let mut bytes = 0usize;
+    let mut type_count = 0usize;
+    if let Some(items) = board.pasteboardItems() {
+        if items.len() > MAX_SNAPSHOT_ITEMS {
+            return Err("clipboard preservation item limit exceeded; nothing was written".into());
+        }
+        for item_index in 0..items.len() {
+            let item = items.objectAtIndex(item_index);
+            let mut values = Vec::new();
+            let kinds = item.types();
+            for type_index in 0..kinds.len() {
+                let kind = kinds.objectAtIndex(type_index);
+                type_count += 1;
+                if type_count > MAX_SNAPSHOT_TYPES {
+                    return Err(
+                        "clipboard preservation type limit exceeded; nothing was written".into(),
+                    );
+                }
+                let data = item
+                    .dataForType(&kind)
+                    .ok_or("clipboard representation is unreadable; nothing was written")?;
+                bytes = bytes
+                    .checked_add(data.len())
+                    .ok_or("clipboard snapshot is too large")?;
+                if bytes > MAX_SNAPSHOT_BYTES {
+                    return Err(
+                        "clipboard preservation byte limit exceeded; nothing was written".into(),
+                    );
+                }
+                values.push((
+                    kind.to_string(),
+                    zeroize::Zeroizing::new(data.bytes().to_vec()),
+                ));
+            }
+            contents.push(values);
+        }
+    } else if board.types().is_some_and(|types| !types.is_empty()) {
+        return Err(
+            "clipboard exposes unreadable legacy representations; nothing was written".into(),
+        );
+    }
+    if board.changeCount() != version {
+        return Err("clipboard changed during preservation; nothing was written".into());
+    }
+    Ok((version, contents))
+}
+
+unsafe fn materialize_items(
+    items: &ClipboardItems,
+) -> Result<objc2::rc::Retained<NSArray<ProtocolObject<dyn NSPasteboardWriting>>>, String> {
+    let mut native_items = Vec::new();
+    for representations in items {
+        let item = NSPasteboardItem::new();
+        for (kind, bytes) in representations {
+            if !item.setData_forType(&NSData::with_bytes(bytes), &NSString::from_str(kind)) {
+                return Err(
+                    "clipboard representation could not be prepared; nothing was written".into(),
+                );
+            }
+        }
+        native_items.push(ProtocolObject::from_retained(item));
+    }
+    Ok(NSArray::from_vec(native_items))
+}
+
+unsafe fn replacement_items(value: ClipboardValue) -> Result<ClipboardItems, String> {
+    let (kind, bytes) = match value {
+        ClipboardValue::Text(text) => ("public.utf8-plain-text", text.into_bytes()),
+        ClipboardValue::Image(path) => {
+            let path = absolute_existing_file(&path)?;
+            let image = bounded_clipboard_image(&path)?;
+            (
+                "public.png",
+                image
+                    .to_png()
+                    .map_err(|error| error.to_string())?
+                    .get_bytes()
+                    .to_vec(),
+            )
+        }
+        ClipboardValue::File(path) => {
+            let path = absolute_existing_file(&path)?;
+            let url = NSURL::fileURLWithPath(&NSString::from_str(&path))
+                .absoluteString()
+                .ok_or("clipboard file URL could not be prepared")?;
+            ("public.file-url", url.to_string().into_bytes())
+        }
+    };
+    if bytes.len() > MAX_SNAPSHOT_BYTES {
+        return Err("clipboard replacement byte limit exceeded; nothing was written".into());
+    }
+    Ok(vec![vec![(kind.into(), zeroize::Zeroizing::new(bytes))]])
+}
+
+unsafe fn write_preserved_to(
+    board: &NSPasteboard,
+    state: &mut Option<PreservedClipboard>,
+    value: ClipboardValue,
+    token: String,
+) -> Result<String, ClipboardPreserveError> {
+    if state
+        .as_ref()
+        .is_some_and(|snapshot| snapshot.expires <= std::time::Instant::now())
+    {
+        let token = state.as_ref().unwrap().token.clone();
+        restore_preserved_to(board, state, &token)?;
+    }
+    if state.is_some() {
+        return Err("a preserved clipboard write is still pending; nothing was written".into());
+    }
+    // Fully prepare payload and restoration before clearing anything.
+    let replacement = materialize_items(&replacement_items(value)?)?;
+    let (version, items) = capture_items(board)?;
+    let _original = materialize_items(&items)?;
+    if board.changeCount() != version {
+        return Err("clipboard changed before replacement; nothing was written".into());
+    }
+    // Retain originals before the first mutation, including failed write/rollback paths.
+    *state = Some(PreservedClipboard {
+        token: token.clone(),
+        expected_change: version,
+        expires: std::time::Instant::now() + SNAPSHOT_TTL,
+        items,
+    });
+    state.as_mut().unwrap().expected_change = board.clearContents();
+    if !board.writeObjects(&replacement) {
+        let _ = restore_preserved_to(board, state, &token);
+        return Err(ClipboardPreserveError::attempted(
+            "clipboard replacement failed; guarded restoration was attempted",
+        ));
+    }
+    Ok(token)
+}
+
+unsafe fn restore_preserved_to(
+    board: &NSPasteboard,
+    state: &mut Option<PreservedClipboard>,
+    token: &str,
+) -> Result<bool, String> {
+    let Some(snapshot) = state.as_ref().filter(|snapshot| snapshot.token == token) else {
+        return Ok(false);
+    };
+    let expected_change = snapshot.expected_change;
+    if board.changeCount() != expected_change {
+        *state = None;
+        return Ok(false);
+    }
+    let items = materialize_items(&snapshot.items)?;
+    if board.changeCount() != expected_change {
+        *state = None;
+        return Ok(false);
+    }
+    // NSPasteboard has no CAS. Keep originals and the new owned count until
+    // restoration succeeds, so a failed write remains recoverable by its token.
+    state.as_mut().unwrap().expected_change = board.clearContents();
+    if !items.is_empty() && !board.writeObjects(&items) {
+        return Err("native clipboard restoration failed; snapshot retained for cleanup".into());
+    }
+    *state = None;
+    Ok(true)
+}
