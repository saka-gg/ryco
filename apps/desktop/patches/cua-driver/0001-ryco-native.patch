+/// The attested driver-owned-headless endpoint of the fixture, exactly as
+/// `browser_prepare` would hand it to the bind path.
+fn windowless_endpoint(f: &Fixture) -> OwnedEndpoint {
+    OwnedEndpoint {
+        ws_url: f.ws_url.clone(),
+        http_port: None,
+        // The revalidation route re-discovers the endpoint through
+        // `discover_owned_endpoint`, which reports this transport.
+        transport: EndpointTransport::LegacyJsonVersion,
+        ownership: EndpointOwnershipProof {
+            method: EndpointOwnershipMethod::SpawnedByDriver,
+            owner_pid: 1,
+            listener_pid: None,
+            detail: Some("fixture driver-spawned headless endpoint".to_owned()),
+        },
+    }
+}
+
+async fn bind_windowless(f: &Fixture) -> (String, String) {
+    let fingerprint = ProcessFingerprint {
+        pid: 1,
+        start_time: Some(1),
+        executable: None,
+    };
+    let (target_id, record) = f
+        .engine
+        .bind_windowless_endpoint(SESSION, None, 1, fingerprint, windowless_endpoint(f))
+        .await
+        .expect("windowless bind must succeed against the fixture endpoint");
+    assert!(record.windowless);
+    assert_eq!(record.cdp_window_id, None);
+    assert_eq!(record.window_id, 0);
+    assert_eq!(record.quality, BindingQuality::Exact);
+    assert_eq!(
+        record.endpoint_access_class,
+        EndpointAccessClass::DriverOwned
+    );
+    assert_eq!(record.tabs.len(), 1);
+    assert!(
+        record.tabs.values().all(|tab| tab.active.is_none()),
+        "a windowless bind never guesses tab selection"
+    );
+    let tab_id = record.tabs.keys().next().unwrap().clone();
+    (target_id, tab_id)
+}
