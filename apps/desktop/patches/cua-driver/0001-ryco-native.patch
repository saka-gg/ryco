+/// Exact layer-0 metadata and Space membership for input admission, without capture.
+///
+/// `kCGWindowListOptionIncludingWindow` alone cannot see minimized or hidden
+/// windows (its base set is the on-screen list, so the query returns nothing),
+/// which mislabeled live minimized windows as `stale_target` and refused
+/// background semantic writes the core policy explicitly permits. When the
+/// targeted query misses, fall back to the full layer-0 enumeration — the same
+/// list `list_windows` reports — before declaring the window gone.
+pub(crate) fn input_window_info_by_id(window_id: u32) -> Option<WindowInfo> {
+    const INCLUDING_WINDOW: u32 = 8;
+    enumerate_window_metadata(
+        INCLUDING_WINDOW | kCGWindowListExcludeDesktopElements,
+        window_id,
+        LayerFilter::ZeroOnly,
+        None,
+        true,
+    )
+    .windows
+    .into_iter()
+    .find(|window| window.window_id == window_id)
+    .or_else(|| {
+        all_windows_with_space_snapshot()
+            .windows
+            .into_iter()
+            .find(|window| window.window_id == window_id)
+    })
+}
