+/// One owned press for [`BrowserPointerTool::dispatch_trusted`]: dialog-aware
+/// when the exact tab target is known.
+async fn press<F, R>(
+    conn: &CdpConnection,
+    cdp_session: &str,
+    dialog_target: Option<&str>,
+    down: Value,
+    release: R,
+    body: F,
+) -> anyhow::Result<Option<CdpDialogState>>
+where
+    F: std::future::Future<Output = anyhow::Result<()>>,
+    R: FnOnce() -> Value,
+{
+    match dialog_target {
+        Some(target) => {
+            let pressed = with_release_until_dialog(
+                conn,
+                cdp_session,
+                target,
+                "Input.dispatchMouseEvent",
+                down,
+                release,
+                body,
+            )
+            .await;
+            pressed.result.map(|()| pressed.dialog)
+        }
+        None => with_release(
+            conn,
+            cdp_session,
+            "Input.dispatchMouseEvent",
+            down,
+            release,
+            body,
+        )
+        .await
+        .map(|()| None),
+    }
+}
