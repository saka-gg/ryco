+//! Trusted-host interruption checkpoints for one browser mutation.
+//!
+//! The host owns admission and the operation's lifetime. Core only checks its
+//! scoped callback before each CDP send and finishes owned input releases.
+//! Ordinary browser reads do not install a scope and remain available.
+
+use std::future::Future;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+
+use serde_json::Value;
+
+use super::cdp_ws::{CdpConnection, CdpDialogState};
+
+type Checkpoint = Arc<dyn Fn() -> anyhow::Result<()> + Send + Sync>;
+type UncertainRelease = Arc<dyn Fn() + Send + Sync>;
+
+struct InputControl {
+    checkpoint: Checkpoint,
+    mark_uncertain_release: UncertainRelease,
+    uncertain_release: AtomicBool,
+}
+
+impl InputControl {
+    fn unresolved_release(&self) {
+        if !self.uncertain_release.swap(true, Ordering::SeqCst) {
+            (self.mark_uncertain_release)();
+        }
+    }
+}
+
+tokio::task_local! {
+    static INPUT_CONTROL: Arc<InputControl>;
+}
+
+/// The caller must retain its admitted operation lease until this scope ends.
+/// A failed release callback must keep its cleanup barrier closed; an OS-level
+/// keyboard release is not evidence that a CDP key or mouse button was released.
+pub async fn scope<F: Future>(
+    checkpoint: Checkpoint,
+    mark_uncertain_release: UncertainRelease,
+    future: F,
+) -> F::Output {
+    INPUT_CONTROL
+        .scope(
+            Arc::new(InputControl {
+                checkpoint,
+                mark_uncertain_release,
+                uncertain_release: AtomicBool::new(false),
+            }),
+            future,
+        )
+        .await
+}
+
+#[derive(Debug)]
+struct Interrupted(String);
+
+impl std::fmt::Display for Interrupted {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(
+            formatter,
+            "browser input interrupted before dispatch: {}",
+            self.0
+        )
+    }
+}
+
+impl std::error::Error for Interrupted {}
+
+pub(crate) fn interrupted_before_send(error: &anyhow::Error) -> bool {
+    error.is::<Interrupted>()
+}
+
+/// Check immediately before a non-CDP actuator, after any async preflight.
+pub(crate) fn checkpoint() -> anyhow::Result<()> {
+    INPUT_CONTROL
+        .try_with(|control| {
+            (control.checkpoint)().map_err(|error| Interrupted(error.to_string()).into())
+        })
+        .unwrap_or(Ok(()))
+}
+
+/// Matching releases and focus cleanup remain legal after admission closes.
+/// Called again after acquiring the writer so queued commands cannot skip Stop.
+pub(crate) fn before_send(method: &str, params: &Value) -> anyhow::Result<()> {
+    let cleanup = match method {
+        "Input.dispatchKeyEvent" => params["type"] == "keyUp",
+        "Input.dispatchMouseEvent" => params["type"] == "mouseReleased",
+        "Emulation.setFocusEmulationEnabled" => params["enabled"] == false,
+        "Browser.setDownloadBehavior" => {
+            params["behavior"] == "default" && params["eventsEnabled"] == false
+        }
+        _ => false,
+    };
+    if cleanup {
+        return Ok(());
+    }
+    checkpoint()
+}
+
+/// Dropping a future after down may leave browser input held. Preserve that
+/// uncertainty even on task cancellation or panic instead of acknowledging a
+/// clean drain when the enclosing operation lease drops.
+struct PendingRelease {
+    control: Option<Arc<InputControl>>,
+}
+
+impl PendingRelease {
+    fn new() -> Self {
+        Self {
+            control: INPUT_CONTROL.try_with(Arc::clone).ok(),
+        }
+    }
+
+    fn resolved(&mut self) {
+        self.control = None;
+    }
+}
+
+impl Drop for PendingRelease {
+    fn drop(&mut self) {
+        if let Some(control) = self.control.take() {
+            control.unresolved_release();
+        }
+    }
+}
+
+/// Always await the matching up, including after an uncertain down reply or a
+/// cancelled intermediate event. A definite pre-send interruption owns no down.
+pub(crate) async fn with_release<F, R>(
+    connection: &CdpConnection,
+    session: &str,
+    method: &str,
+    down: Value,
+    release: R,
+    body: F,
+) -> anyhow::Result<()>
+where
+    F: Future<Output = anyhow::Result<()>>,
+    R: FnOnce() -> Value,
+{
+    let (result, _) = guarded_release(connection, session, method, down, release, body, None).await;
+    result
+}
+
+/// What a dialog-aware press reported.
+pub(crate) struct DialogAwareRelease {
+    pub(crate) result: anyhow::Result<()>,
+    /// The page-owned dialog that opened during the down or the release.
+    pub(crate) dialog: Option<CdpDialogState>,
+}
+
+/// [`with_release`] for input whose handler may open a page-owned JavaScript
+/// dialog on `dialog_target`. The dialog blocks the renderer, which then acks
+/// the down or the release only after the dialog closes. A release that is on
+/// the wire while that dialog is open is the defined end state (the button is
+/// not left held by us), so it never counts as an unconfirmed release. The
+/// body is skipped once a dialog opened during the down.
+pub(crate) async fn with_release_until_dialog<F, R>(
+    connection: &CdpConnection,
+    session: &str,
+    dialog_target: &str,
+    method: &str,
+    down: Value,
+    release: R,
+    body: F,
+) -> DialogAwareRelease
+where
+    F: Future<Output = anyhow::Result<()>>,
+    R: FnOnce() -> Value,
+{
+    let (result, dialog) = guarded_release(
+        connection,
+        session,
+        method,
+        down,
+        release,
+        body,
+        Some(dialog_target),
+    )
+    .await;
+    DialogAwareRelease { result, dialog }
+}
+
+async fn guarded_release<F, R>(
+    connection: &CdpConnection,
+    session: &str,
+    method: &str,
+    down: Value,
+    release: R,
+    body: F,
+    dialog_target: Option<&str>,
+) -> (anyhow::Result<()>, Option<CdpDialogState>)
+where
+    F: Future<Output = anyhow::Result<()>>,
+    R: FnOnce() -> Value,
+{
+    let mut pending = PendingRelease::new();
+    let open_dialog = || dialog_target.and_then(|target| connection.dialog_state(target));
+    let mut opened = None;
+    let down = match connection
+        .call_until(Some(session), method, down, open_dialog)
+        .await
+    {
+        Ok(reply) => reply,
+        // The down is on the wire and its handler opened the dialog.
+        Err(open) => {
+            opened = Some(open);
+            Ok(Value::Null)
+        }
+    };
+    if down.as_ref().is_err_and(interrupted_before_send) {
+        pending.resolved();
+        return (down.map(|_| ()), opened);
+    }
+    let delivery = match down {
+        Ok(_) if opened.is_some() => Ok(()),
+        Ok(_) => body.await,
+        Err(error) => Err(error),
+    };
+    let released = match connection
+        .call_until(Some(session), method, release(), open_dialog)
+        .await
+    {
+        Ok(reply) => reply.map(|_| ()),
+        // Sent while the dialog blocks the renderer: its ack waits for the
+        // dialog to close, but the release is already queued behind it.
+        Err(open) => {
+            opened.get_or_insert(open);
+            Ok(())
+        }
+    };
+    if released.is_ok() {
+        pending.resolved();
+    }
+    (delivery.and(released), opened)
+}
+
