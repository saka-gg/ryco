+/// A command acknowledgement is not navigation evidence. Compare one fresh
+/// main-frame read with both the destination and the document the command
+/// addressed. Redirects or a loading/previous document remain unconfirmed.
+fn navigation_destination_matches(url: &str, navigation: &Value, state: &Value) -> bool {
+    if navigation.get("isDownload").and_then(Value::as_bool) == Some(true) {
+        return false;
+    }
+    let Some(frame_id) = navigation.get("frameId").and_then(Value::as_str) else {
+        return false;
+    };
+    if frame_id.is_empty() {
+        return false;
+    }
+    let frame = &state["frameTree"]["frame"];
+    if frame.get("id").and_then(Value::as_str) != Some(frame_id) {
+        return false;
+    }
+    // CDP omits loaderId for same-document navigation. In that case the live
+    // frame and exact URL are the postcondition; no new document is claimed.
+    match navigation.get("loaderId") {
+        None => {}
+        Some(Value::String(loader)) if !loader.is_empty() => {
+            if frame.get("loaderId").and_then(Value::as_str) != Some(loader.as_str()) {
+                return false;
+            }
+        }
+        _ => return false,
+    }
+    let Some(observed_url) = frame.get("url").and_then(Value::as_str) else {
+        return false;
+    };
+    let (Ok(expected), Ok(mut observed)) = (url::Url::parse(url), url::Url::parse(observed_url))
+    else {
+        return false;
+    };
+    // CDP reports the frame URL and fragment separately. Do not drop a
+    // requested fragment or mistake a different section for the destination.
+    if let Some(fragment) = frame.get("urlFragment") {
+        let Some(fragment) = fragment.as_str().and_then(|value| value.strip_prefix('#')) else {
+            return false;
+        };
+        observed.set_fragment(Some(fragment));
+    }
+    expected == observed
+}
