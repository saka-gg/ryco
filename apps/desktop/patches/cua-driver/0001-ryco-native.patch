+                    anyhow::anyhow!(
+                        "modal_target_mismatch: the semantic element's window cannot be proven"
+                    )
+                })?;
+            target.verify_modal(Some(element))?;
+        } else {
+            for target in state.concurrent_targets.values() {
+                target.verify_modal(None)?;
+            }
+        }
