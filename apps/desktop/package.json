{
  "name": "@ryco/desktop",
  "version": "0.1.21",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "bun run build:native && bun run --parallel dev:bundle dev:electron",
    "dev:bundle": "tsdown --watch",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "bun run build:native && tsdown",
    "build:native": "node scripts/build-native-security-helper.mjs && node scripts/build-computer-use-helper.mjs",
    "start": "node scripts/start-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test run --passWithNoTests",
    "smoke-test": "node scripts/smoke-test.mjs",
    "startup-timing-smoke": "node scripts/startup-timing-smoke.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "electron": "43.4.0",
    "electron-updater": "^6.8.9",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@ryco/client-runtime": "workspace:*",
    "@ryco/contracts": "workspace:*",
    "@ryco/shared": "workspace:*",
    "@ryco/ssh": "workspace:*",
    "@ryco/tailscale": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "effect-acp": "workspace:*",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "productName": "Ryco"
}
