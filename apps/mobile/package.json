    "babel-preset-expo": "~57.0.11",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "autolinking": {
      "buildFromSource": [
        "react-native-screens",
        "@react-native-menu/menu"
      ]
    }
  }
