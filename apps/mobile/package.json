{
  "name": "@ryco/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --clear",
    "dev:client": "APP_VARIANT=development expo start --dev-client --scheme ryco-dev --clear --lan",
    "start": "expo start",
    "start:dev": "APP_VARIANT=development expo start",
    "start:preview": "APP_VARIANT=preview expo start",
    "start:prod": "APP_VARIANT=production expo start",
    "android": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform android && expo run:android",
    "android:dev": "APP_VARIANT=development EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform android && REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:android",
    "ios": "LANG=en_US.UTF-8 EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && LANG=en_US.UTF-8 expo run:ios",
    "ios:dev": "LANG=en_US.UTF-8 APP_VARIANT=development EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && LANG=en_US.UTF-8 expo run:ios",
    "eas:ios:dev": "eas build --profile development -p ios",
    "eas:ios:preview": "eas build --profile preview -p ios",
    "eas:ios:prod": "eas build --profile production -p ios",
    "config:dev": "APP_VARIANT=development expo config",
    "config:preview": "APP_VARIANT=preview expo config",
    "config:prod": "APP_VARIANT=production expo config",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.8.1",
    "@effect/atom-react": "catalog:",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/ui": "~57.0.17",
    "@legendapp/list": "3.3.10",
    "@pierre/diffs": "1.4.1",
    "@react-native-menu/menu": "^2.0.0",
    "@react-navigation/elements": "2.9.40",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@ryco/client-runtime": "workspace:*",
    "@ryco/contracts": "workspace:*",
    "@ryco/mobile-device-key": "workspace:*",
    "@ryco/mobile-markdown-text": "workspace:*",
    "@ryco/mobile-review-diff-native": "workspace:*",
    "@ryco/shared": "workspace:*",
    "@shikijs/core": "4.4.3",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@tabler/icons-react-native": "^3.46.0",
    "clsx": "^2.1.1",
