#!/usr/bin/env node
/// <reference types="node" />
/**
 * Generates `src/features/devices/stream/renderer/device-stream.html`, the one
 * document the device viewer's WebView loads: the renderer entry (and the
 * shared WebCodecs decoder from `@ryco/client-runtime/deviceVideo`) bundled
 * into a minified inline script, under a Content Security Policy that admits
 * exactly that script by its SHA-256 and denies every network, storage-adjacent
 * and embedding resource class. Frames arrive over the postMessage bridge, so
 * the document needs no network at all.
 *
 * Deterministic, checked in, and verified byte for byte by
 * `deviceStreamDocument.test.ts`. Regenerate with
 * `bun run --cwd apps/mobile build:device-stream-renderer`.
 */
import { readFile, writeFile } from "node:fs/promises";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

import {
  bundleInlineRendererScript,
  escapeInlineScript,
  inlineScriptHash,
} from "./inlineRendererBundle.mts";

const scriptDir = dirname(fileURLToPath(import.meta.url));
const mobileDir = resolve(scriptDir, "..");
const sourceDir = join(mobileDir, "src/features/devices/stream/renderer");
export const DEVICE_STREAM_DOCUMENT_PATH = join(sourceDir, "device-stream.html");

/** Every directive is fixed except the build-derived script hash. */
export function deviceStreamContentSecurityPolicy(scriptHash: string): string {
  return [
    "default-src 'none'",
    `script-src 'sha256-${scriptHash}'`,
    "style-src 'unsafe-inline'",
    "connect-src 'none'",
    "img-src 'none'",
    "media-src 'none'",
    "font-src 'none'",
    "frame-src 'none'",
    "object-src 'none'",
    "worker-src 'none'",
    "manifest-src 'none'",
    "form-action 'none'",
    "base-uri 'none'",
  ].join("; ");
}

const STYLE = [
  "html,body{margin:0;height:100%;overflow:hidden;background:#000;touch-action:none;",
  "-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}",
  "#screen{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);",
  "width:0;height:0;touch-action:none}",
].join("");

/** The generated document, built in memory. */
export async function buildDeviceStreamDocument(): Promise<string> {
  const script = escapeInlineScript(
    await bundleInlineRendererScript({
      root: sourceDir,
      entry: join(sourceDir, "deviceStreamRenderer.ts"),
      name: "RycoDeviceStreamRenderer",
    }),
  );
  return [
    "<!doctype html>",
    "<!-- Generated by scripts/build-device-stream-renderer.mts. Do not edit. -->",
    '<html><head><meta charset="utf-8">',
    `<meta http-equiv="Content-Security-Policy" content="${deviceStreamContentSecurityPolicy(inlineScriptHash(script))}">`,
    '<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">',
    `<style>${STYLE}</style></head>`,
    '<body><canvas id="screen"></canvas>',
    `<script>${script}</script></body></html>`,
    "",
  ].join("\n");
}

if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
  const document = await buildDeviceStreamDocument();
  if (process.argv.includes("--check")) {
    const current = await readFile(DEVICE_STREAM_DOCUMENT_PATH, "utf8").catch(() => null);
    if (current !== document) {
      process.stderr.write(
        "device-stream.html is stale; run `bun run --cwd apps/mobile build:device-stream-renderer`.\n",
      );
      process.exitCode = 1;
    }
  } else {
    await writeFile(DEVICE_STREAM_DOCUMENT_PATH, document, "utf8");
  }
}
