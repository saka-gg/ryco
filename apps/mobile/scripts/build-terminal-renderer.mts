#!/usr/bin/env node
/// <reference types="node" />
/**
 * Generates `src/features/terminal/renderer/terminal-renderer.html`, the one
 * document the terminal WebView loads: the renderer entry and xterm.js bundled
 * into a minified inline script, xterm's stylesheet, and a Content Security
 * Policy that admits exactly that script by its SHA-256 and denies every
 * network, storage-adjacent and embedding resource class.
 *
 * The output is deterministic, checked in, and verified byte for byte by
 * `terminalRendererDocument.test.ts`, so a dependency or source change cannot
 * leave a stale renderer behind. Regenerate with
 * `bun run --cwd apps/mobile build:terminal-renderer`.
 */
import { createHash } from "node:crypto";
import { readFile, writeFile } from "node:fs/promises";
import { createRequire } from "node:module";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";
import { build } from "vite-plus";

const scriptDir = dirname(fileURLToPath(import.meta.url));
const mobileDir = resolve(scriptDir, "..");
const sourceDir = join(mobileDir, "src/features/terminal/renderer");
export const TERMINAL_RENDERER_DOCUMENT_PATH = join(sourceDir, "terminal-renderer.html");
const require = createRequire(import.meta.url);

/** Every directive is fixed except the build-derived script hash. */
export function terminalRendererContentSecurityPolicy(scriptHash: string): string {
  return [
    "default-src 'none'",
    `script-src 'sha256-${scriptHash}'`,
    // xterm creates and updates inline renderer styles; script never runs inline unhashed.
    "style-src 'unsafe-inline'",
    "connect-src 'none'",
    "img-src 'none'",
    "media-src 'none'",
    "font-src 'none'",
    "frame-src 'none'",
    "object-src 'none'",
    "worker-src 'none'",
    "manifest-src 'none'",
    "form-action 'none'",
    "base-uri 'none'",
  ].join("; ");
}

async function packageVersion(name: string): Promise<string> {
  const packagePath = require.resolve(`${name}/package.json`, { paths: [mobileDir] });
  return (JSON.parse(await readFile(packagePath, "utf8")) as { version: string }).version;
}

function escapeInlineScript(script: string): string {
  return script.replaceAll(/<\/script/giu, "<\\/script");
}

function escapeInlineStyle(style: string): string {
  return style.replaceAll(/<\/style/giu, "<\\/style");
}

async function bundleRendererScript(): Promise<string> {
  const result = await build({
    configFile: false,
    envFile: false,
    logLevel: "silent",
    root: sourceDir,
    mode: "production",
    define: { "process.env.NODE_ENV": JSON.stringify("production") },
    build: {
      write: false,
      emptyOutDir: false,
      copyPublicDir: false,
      minify: true,
      sourcemap: false,
      reportCompressedSize: false,
      target: "es2020",
      lib: {
        entry: join(sourceDir, "terminalRenderer.ts"),
        formats: ["iife"],
        name: "RycoTerminalRenderer",
        fileName: () => "renderer.js",
      },
    },
  });
  const outputs = Array.isArray(result) ? result : [result];
  for (const output of outputs) {
    if (!("output" in output)) continue;
    for (const chunk of output.output) {
      if (chunk.type === "chunk" && chunk.isEntry) return chunk.code.trim();
    }
  }
  throw new Error("The terminal renderer bundle produced no entry chunk.");
}

/** The generated document, built in memory. */
export async function buildTerminalRendererDocument(): Promise<string> {
  const script = escapeInlineScript(await bundleRendererScript());
  const xtermCssPath = require.resolve("@xterm/xterm/css/xterm.css", { paths: [mobileDir] });
  const style = escapeInlineStyle(
    `${(await readFile(xtermCssPath, "utf8")).trim()}\n${(
      await readFile(join(sourceDir, "terminalRenderer.css"), "utf8")
    ).trim()}`,
  );
  const digest = createHash("sha256").update(script, "utf8").digest("base64");
  const [xtermVersion, fitVersion] = await Promise.all([
    packageVersion("@xterm/xterm"),
    packageVersion("@xterm/addon-fit"),
  ]);
  return [
    "<!doctype html>",
    `<!-- Generated by scripts/build-terminal-renderer.mts; xterm ${xtermVersion}; fit ${fitVersion}. Do not edit. -->`,
    '<html><head><meta charset="utf-8">',
    `<meta http-equiv="Content-Security-Policy" content="${terminalRendererContentSecurityPolicy(digest)}">`,
    '<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">',
    `<style>${style}</style></head>`,
    '<body><div id="terminal-root"></div>',
    `<script>${script}</script></body></html>`,
    "",
  ].join("\n");
}

if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
  const document = await buildTerminalRendererDocument();
  if (process.argv.includes("--check")) {
    const current = await readFile(TERMINAL_RENDERER_DOCUMENT_PATH, "utf8").catch(() => null);
    if (current !== document) {
      process.stderr.write(
        "terminal-renderer.html is stale; run `bun run --cwd apps/mobile build:terminal-renderer`.\n",
      );
      process.exitCode = 1;
    }
  } else {
    await writeFile(TERMINAL_RENDERER_DOCUMENT_PATH, document, "utf8");
  }
}
