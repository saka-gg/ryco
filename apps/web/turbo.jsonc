{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "persistent": true,
      // Unused: the web build no longer keeps a React Compiler transform
      // cache. A follow-up removes these with the CI cache steps.
      "passThroughEnv": ["RYCO_REACT_COMPILER_CACHE", "RYCO_REACT_COMPILER_CACHE_DIR"],
    },
  },
}
