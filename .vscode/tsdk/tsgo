#!/bin/sh
# VS Code's TypeScript 7 extension starts `<tsdk>/tsgo --lsp --stdio`. This execs the tsrs binary
# that `effect-tsgo tsrs` runs (the CLI typecheck), so the editor reports the same TypeScript and
# Effect diagnostics. It skips the effect-tsgo Node launcher, which only resolves this path and
# execs it; t3code saw the LSP's stdin reads fail intermittently (EAGAIN) through the launcher.
exec "$(cd "$(dirname "$0")/../.." && node -e '
const { createRequire } = require("node:module");
const fs = require("node:fs");
const path = require("node:path");
const platform = `@effect/tsgo-${process.platform}-${process.arch}/package.json`;
const dir = path.join(path.dirname(createRequire(require.resolve("@effect/tsgo/package.json")).resolve(platform)), "artifacts/tsrs");
process.stdout.write(path.join(dir, fs.readdirSync(dir).sort().at(-1), "tsrs"));
')" "$@"
