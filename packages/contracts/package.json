{
  "name": "@ryco/contracts",
  "version": "0.1.24",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    "./settings": {
      "types": "./src/settings.ts",
      "import": "./src/settings.ts",
      "require": "./src/settings.ts"
    },
    "./relay": {
      "types": "./src/relay.ts",
      "import": "./src/relay.ts",
      "require": "./src/relay.ts"
    },
    "./native-handoff": {
      "types": "./src/nativeHandoff.ts",
      "import": "./src/nativeHandoff.ts",
      "require": "./src/nativeHandoff.ts"
    },
    "./hosted-identity": {
      "types": "./src/hostedIdentity.ts",
      "import": "./src/hostedIdentity.ts",
      "require": "./src/hostedIdentity.ts"
    },
    "./native-e2ee": {
      "types": "./src/nativeE2ee.ts",
      "import": "./src/nativeE2ee.ts",
      "require": "./src/nativeE2ee.ts"
    },
    "./local-introduction": {
      "types": "./src/localIntroduction.ts",
      "import": "./src/localIntroduction.ts",
      "require": "./src/localIntroduction.ts"
    },
    "./desktop-native-node-claim": {
      "types": "./src/desktopNativeNodeClaim.ts",
      "import": "./src/desktopNativeNodeClaim.ts",
      "require": "./src/desktopNativeNodeClaim.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "tsdown src/index.ts --format esm,cjs --dts --watch --clean",
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
