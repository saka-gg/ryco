{
  "name": "@ryco/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "apps/mobile/modules/*",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "effect": "4.0.0-beta.107",
      "@effect/atom-react": "4.0.0-beta.107",
      "@effect/openapi-generator": "4.0.0-beta.107",
      "@effect/platform-bun": "4.0.0-beta.107",
      "@effect/platform-node": "4.0.0-beta.107",
      "@effect/platform-node-shared": "4.0.0-beta.107",
      "@effect/sql-sqlite-bun": "4.0.0-beta.107",
      "@effect/vitest": "4.0.0-beta.107",
      "@effect/tsgo": "0.43.0",
      "@noble/ciphers": "2.3.0",
      "@noble/curves": "2.3.0",
      "@noble/hashes": "2.3.0",
      "@pierre/diffs": "1.4.1",
      "@types/bun": "^1.4.2",
      "@types/node": "^24.13.3",
      "@types/ws": "8.18.1",
      "cborg": "6.1.2",
      "fast-check": "4.9.0",
      "tsdown": "^0.23.0",
      "typescript": "7.0.2",
      "vitest": "4.1.11",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
      "vite-plus": "0.3.1",
      "ws": "8.21.3"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript",
    "dev": "node scripts/dev-runner.ts dev",
    "dev:server": "node scripts/dev-runner.ts dev:server",
    "dev:web": "node scripts/dev-runner.ts dev:web",
    "dev:desktop": "node scripts/dev-runner.ts dev:desktop",
    "start": "turbo run start --filter=ryco-cli",
    "start:desktop": "turbo run start --filter=@ryco/desktop",
    "start:mock-update-server": "node scripts/mock-update-server.ts",
    "build": "turbo run build",
    "build:desktop": "turbo run build --filter=@ryco/desktop --filter=ryco-cli",
    "typecheck": "turbo run typecheck",
    "lint": "vp lint --report-unused-disable-directives",
    "test": "turbo run test",
    "test:desktop-smoke": "turbo run smoke-test --filter=@ryco/desktop",
    "test:device": "bun scripts/device-helper-smoke.ts",
    "test:device:probe": "bun scripts/device-helper-smoke.ts --probe-only",
    "test:device:sweep": "bun scripts/device-helper-sweep.ts",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "build:contracts": "turbo run build --filter=@ryco/contracts",
    "generate:relay-fixtures": "bun scripts/generate-relay-fixtures.ts",
    "generate:node-identity-fixtures": "bun scripts/generate-node-identity-fixtures.ts",
    "generate:e2ee-fixtures": "bun scripts/generate-e2ee-fixtures.ts",
    "measure:relay-chunk-perf": "bun scripts/measure-relay-chunk-perf.ts",
    "dist:desktop:artifact": "node scripts/build-desktop-artifact.ts",
    "dist:desktop:dmg": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch arm64",
    "dist:desktop:dmg:arm64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch arm64",
    "dist:desktop:linux": "node scripts/build-desktop-artifact.ts --platform linux --target AppImage --arch x64",
    "dist:desktop:win": "node scripts/build-desktop-artifact.ts --platform win --target nsis",
    "dist:desktop:win:arm64": "node scripts/build-desktop-artifact.ts --platform win --target nsis --arch arm64",
    "dist:desktop:win:x64": "node scripts/build-desktop-artifact.ts --platform win --target nsis --arch x64",
    "release:smoke": "node scripts/release-smoke.ts",
    "measure:web-bundle": "node scripts/measure-web-bundle.ts",
    "measure:desktop-stage": "node scripts/measure-desktop-stage.ts",
    "perf:smoke": "bun scripts/perf/cli.ts smoke",
    "perf:external": "bun scripts/perf/cli.ts run",
    "perf:source-control": "bun scripts/perf/cli.ts run --profile active-source-control --iterations 1",
    "perf:compare": "bun scripts/perf/cli.ts compare-refs",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/dist-electron packages/*/dist .turbo apps/*/.turbo packages/*/.turbo",
    "sync:vscode-icons": "node scripts/sync-vscode-icons.mjs"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@effect/atom-react": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@effect/vitest": "catalog:",
    "@hono/node-server": "1.19.17",
    "@xmldom/xmldom": "0.8.15",
    "body-parser": "2.3.0",
    "browserslist": "4.28.9",
    "effect": "catalog:",
    "fast-uri": "3.1.7",
    "form-data": "4.0.6",
    "hono": "4.13.2",
    "ip-address": "10.5.0",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "next": "16.3.1",
    "qs": "6.16.0",
    "query-string": {
      "decode-uri-component": "0.5.0"
    },
    "react-native-nitro-markdown": "0.10.0",
    "tar": "7.5.22",
    "vite": "catalog:",
    "vitest": "catalog:",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "bun": "^1.4.0",
    "node": "^24.13.1"
  },
  "packageManager": "bun@1.4.0",
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  },
  "patchedDependencies": {
    "@react-native-menu/menu@2.0.0": "patches/@react-native-menu__menu@2.0.0.patch",
    "effect@4.0.0-beta.107": "patches/effect@4.0.0-beta.107.patch",
    "react-native-gesture-handler@2.32.0": "patches/react-native-gesture-handler@2.32.0.patch",
    "react-native-screens@4.26.2": "patches/react-native-screens@4.26.2.patch",
    "@legendapp/list@3.3.10": "patches/@legendapp%2Flist@3.3.10.patch",
    "expo-modules-jsi@57.1.0": "patches/expo-modules-jsi@57.1.0.patch",
    "@react-navigation/native-stack@7.18.10": "patches/@react-navigation%2Fnative-stack@7.18.10.patch",
    "@pierre/diffs@1.4.1": "patches/@pierre%2Fdiffs@1.4.1.patch",
    "query-string@7.1.3": "patches/query-string@7.1.3.patch",
    "react-native-keyboard-controller@1.21.9": "patches/react-native-keyboard-controller@1.21.9.patch",
    "react-native-nitro-modules@0.36.5": "patches/react-native-nitro-modules@0.36.5.patch"
  },
  "trustedDependencies": [
    "node-pty",
    "electron"
  ]
}
