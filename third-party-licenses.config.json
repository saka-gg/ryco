{
  "$comment": "Hand-maintained inputs of the phone app's open source license manifest; see 'Open source licenses' in apps/mobile/README.md.",
  "buildOnlyDependencies": [
    {
      "from": "@expo/cli",
      "names": ["*"],
      "reason": "Expo's CLI and dev server. Only its module loader (build/metro-require/require.js) is bundled, and it imports nothing."
    },
    {
      "from": "expo",
      "names": [
        "@expo/config",
        "@expo/config-plugins",
        "@expo/fingerprint",
        "@expo/local-build-cache-provider",
        "@expo/metro",
        "@expo/metro-config",
        "babel-preset-expo",
        "expo-modules-autolinking",
        "pretty-format",
        "react-refresh"
      ],
      "reason": "Bundler, Babel, fingerprint, config and autolinking tooling; runs while building."
    },
    {
      "from": "react-native",
      "names": [
        "@react-native/codegen",
        "@react-native/community-cli-plugin",
        "@react-native/gradle-plugin",
        "babel-plugin-syntax-hermes-parser",
        "commander",
        "hermes-compiler",
        "metro-runtime",
        "metro-source-map",
        "pretty-format",
        "react-devtools-core",
        "react-refresh",
        "tinyglobby",
        "ws",
        "yargs"
      ],
      "reason": "CLI, codegen, Gradle plugin, Hermes compiler and development tools; none of them is bundled."
    },
    {
      "from": "expo-updates",
      "names": [
        "@expo/code-signing-certificates",
        "@expo/plist",
        "@expo/spawn-async",
        "arg",
        "chalk",
        "debug",
        "getenv",
        "glob",
        "ignore",
        "resolve-from"
      ],
      "reason": "Dependencies of expo-updates' command-line tools and config plugin, which run while building."
    },
    {
      "from": "react-native-worklets",
      "names": ["@babel/*", "convert-source-map"],
      "reason": "Dependencies of the worklets Babel plugin, which runs while bundling."
    },
    {
      "from": "uniwind",
      "names": ["@tailwindcss/*", "lightningcss", "tailwindcss"],
      "reason": "Dependencies of uniwind's Metro plugin, which compiles the Tailwind styles while bundling."
    },
    {
      "from": "*",
      "names": [
        "@expo/config-plugins",
        "@expo/config-types",
        "@expo/image-utils",
        "@expo/plist",
        "@expo/prebuild-config",
        "xml2js"
      ],
      "reason": "Config plugins run during prebuild, not in the app."
    },
    {
      "from": "@ryco/mobile",
      "names": ["expo-build-properties"],
      "reason": "A config plugin only: it sets native build properties during prebuild."
    }
  ],
  "bundledDevDependencies": [
    {
      "bundle": "mobile",
      "packageManifest": "apps/mobile/package.json",
      "names": ["@pierre/trees", "@xterm/addon-fit", "@xterm/xterm"],
      "reason": "Inlined into checked-in artifacts the app ships: xterm.js and its fit addon into the terminal WebView document (scripts/build-terminal-renderer.mts), the Pierre file icons into the markdown module's assets (modules/ryco-markdown-text/scripts/sync-pierre-file-icons.mjs)."
    }
  ],
