{
  "$schema": "https://turbo.build/schema.json",
  // Root configs every package's tsconfig extends. Listed here so a change to
  // them busts every task's cache — without this, the cached typecheck/build
  // could return a stale pass after a shared compiler-option change.
  "globalDependencies": [
    "tsconfig.base.json",
    "tsconfig.node.json",
    // Shared test configuration and build helpers are imported across workspace
    // boundaries that Turbo cannot infer from package dependencies.
    // The Vitest helpers stay at the root, outside every workspace: `--affected`
    // selects every package for a changed root global dependency, but attributes
    // a file inside a workspace (such as scripts/) to that workspace alone, so PR
    // runs would skip the suites the helper configures.
    "vitest.config.ts",
    "vitest.reporting.ts",
    "vitest.pure-projects.ts",
    "vitest.workers.ts",
    "scripts/lib/brand-assets.ts",
    "scripts/lib/resolve-catalog.ts",
    "scripts/lib/build-timing.ts",
    "scripts/lib/native-build-cache.ts",
    "native/resource-monitor/Cargo.toml",
    "native/resource-monitor/Cargo.lock",
    "native/resource-monitor/rust-toolchain.toml",
    "native/resource-monitor/src/**",
    "scripts/build-resource-monitor.ts",
    "scripts/resource-monitor-target.ts",
    // bun.lock records only patch paths, not their content; a patch edit changes
    // installed types and code without changing any other hashed input.
    "patches/**"
  ],
  "globalEnv": [
    "HOST",
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "RYCO_LOG_WS_EVENTS",
    "RYCO_MODE",
    "RYCO_PORT",
    "RYCO_NO_BROWSER",
    "RYCO_HOME",
    "RYCO_AUTH_TOKEN",
    "RYCO_TAILSCALE_SERVE",
    "RYCO_TAILSCALE_SERVE_PORT",
    "RYCO_DESKTOP_WS_URL",
    "RYCO_TRACE_MIN_LEVEL",
    "RYCO_TRACE_TIMING_ENABLED",
    "RYCO_TRACE_FILE",
    "RYCO_TRACE_MAX_BYTES",
    "RYCO_TRACE_MAX_FILES",
    "RYCO_TRACE_BATCH_WINDOW_MS",
    "RYCO_OTLP_TRACES_URL",
    "RYCO_OTLP_METRICS_URL",
    "RYCO_OTLP_EXPORT_INTERVAL_MS",
    "RYCO_OTLP_SERVICE_NAME"
  ],
  "globalPassThroughEnv": ["PATHEXT"],
  // Bound the local cache, which git worktrees share and which otherwise only
  // grows. Turbo evicts in the background when a run starts. Age counts from
  // when an entry was written (a hit does not renew it), so at worst a
  // long-lived entry is recomputed once a week.
  "cacheMaxAge": "7d",
  "cacheMaxSize": "2GB",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"],
      // Start from Turbo's default (every git-tracked file in the package) and
      // subtract inputs that can't affect build output: docs and test files.
      // This stops a README or test-only edit from busting the build cache
      // without risking a stale hit on a real source change.
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.test.ts", "!**/*.test.tsx", "!**/*.spec.ts"]
    },
    "@ryco/web#build": {
      "dependsOn": ["^build"],
      // CI builds with hidden sourcemaps so the bundle budget check
      // (`bun run perf:bundle-budget`) can attribute every chunk to its modules.
      // Hashing the React Compiler cache switch keeps a build that turns the
      // cache off (every release) from being served one that read it.
      "env": ["RYCO_WEB_SOURCEMAP", "RYCO_REACT_COMPILER_CACHE"],
      "passThroughEnv": ["RYCO_REACT_COMPILER_CACHE_DIR"],
      "outputs": ["dist/**"],
      // Tailwind scans test fixtures too. Keep them in this package's hash so
      // a utility added in a test cannot change CSS behind a stale cache hit.
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "@ryco/desktop#build": {
      "dependsOn": ["^build"],
      "env": ["RYCO_DESKTOP_ARCH"],
      "outputs": [
        "dist-electron/**",
        "resources/ryco-desktop-security-helper",
        "resources/ryco-computer-use-helper*",
        "resources/browser-extension/**",
        "resources/computer-use-licenses/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    // Transit node: no package defines a "typecheck:deps" script, so it never
    // runs. Every package's checker reads workspace dependencies from source,
    // so no check waits on another; this only threads each dependency's file
    // hash into the typecheck hashes below, so a dependency edit still busts
    // the cache while all packages check in parallel.
    "typecheck:deps": {
      "dependsOn": ["^typecheck:deps"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "typecheck": {
      "dependsOn": ["typecheck:deps"],
      "outputs": [],
      // Cacheable: tsc is deterministic, so an unchanged package's pass/fail can
      // be memoized by input hash and skipped on reruns. Keep test files in the
      // input set (they're type-checked); only docs are irrelevant.
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    // tsc-rs pre-check; same cache rules as typecheck. Its incremental build
    // info lives in each package's gitignored .turbo/, outside the inputs.
    "typecheck:fast": {
      "dependsOn": ["typecheck:deps"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "test": {
      // Not result-cached: tests may not be pure (clock/network/fs), so a green
      // must never be memoized. PR runs skip untouched packages via `--affected`
      // instead, which is sound regardless of test purity. Workspace packages
      // resolve from source, so tests never wait on an upstream build.
      "dependsOn": [],
      "cache": false,
      "outputs": [],
      // The shared Vitest worker override (vitest.workers.ts).
      // Strict env mode would strip it from every suite Turbo starts.
      "passThroughEnv": ["RYCO_TEST_MAX_WORKERS"]
    }
  }
}
